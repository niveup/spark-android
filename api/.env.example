# Copy to api/.env (git-ignored, never commit). Server environment variables only.
#
# For Local Development:
# DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"
#
# For Cloud Deployment (Vercel / Serverless):
# Use Supabase's Connection Pooler URL (port 6543 with pgbouncer/supavisor mode)
# to avoid exhausting database connection limits in serverless functions:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"

# Single-user passcode (login secret; pick anything long, stays on server):
SPARK_PASSCODE="change-me-to-a-long-random-passcode"

# Telegram Bot Token for book audio & cover fetching:
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
