{
  "name": "spark-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "tsx --test test/*.test.ts",
    "test:unit": "tsx --test test/client-ip.test.ts test/ranking.test.ts test/pipeline.test.ts test/growth.test.ts test/quotes.test.ts",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "ingest:resolve": "tsx prisma/resolve-books.ts",
    "ingest:growth": "tsx prisma/ingest-growth.ts",
    "ingest:quotes": "tsx prisma/ingest-quotes.ts",
    "ingest:review": "tsx prisma/review-growth.ts",
    "ingest:publish": "tsx prisma/publish-growth.ts",
    "content:archive-audio": "tsx prisma/archive-audio.ts",
    "content:archive-legacy-quotes": "tsx prisma/archive-legacy-quotes.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.10",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
