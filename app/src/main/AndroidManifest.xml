<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 4: API client needs network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Observe default-network changes so the compact offline action stays current. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 6: audiobook stream playback keeps running with the screen off.
         The app streams by URL — nothing audio-shaped is stored on the device. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- No POST_NOTIFICATIONS: Media3's media-session notification is exempt
         on Android 13+, and the app never posts a normal notification. -->

    <application
        android:name=".SparkApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:fullBackupOnly="false"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="SPARK"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SPARK"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">
        <!-- Phase 8: the Sentry SDK auto-installs a ContentProvider that runs
             BEFORE Application.onCreate() and initialises the SDK itself. With
             our DSN coming from BuildConfig (not the manifest) that provider
             has no DSN and kills the app at startup. Turning auto-init off
             leaves exactly one init path: SentryAndroid.init in SparkApp. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SPARK">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "I'm bored" shortcut (res/xml/shortcuts.xml) uses an explicit
                 intent to this activity, so no custom-action filter is exported. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Phase 8: shares exported saved cards (JSON/Markdown) as a file
             attachment. Only cache/exports is exposed, read-only, and only
             for the duration of the share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Phase 6: audiobook playback service. Not exported; Media3 connects
             through a locally-created SessionToken. Lock-screen media controls
             and the notification come from Media3's MediaSession defaults. -->
        <service
            android:name=".audio.AudioBookService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
