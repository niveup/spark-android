<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY: the API is reached through `adb reverse tcp:3000 tcp:3000`,
     so the phone calls http://127.0.0.1:3000 on the USB tunnel. Cleartext is
     allowed only for loopback; every other host still requires HTTPS.
     Release builds use the main res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
