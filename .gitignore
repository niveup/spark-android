# Content automation: the inbox payload is data, never source. The workflow
# also writes it to $RUNNER_TEMP, so nothing generated reaches this file.
api/prisma/inbox/cards.json
api/prisma/inbox/*.incoming.json

# IDE Agent skills
.agents/
skills-lock.json

# Design-skill working files: direction seed and candidate source photos.
